{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comfforts:app-platform:schema:compiled-shared-edge:v1",
  "title": "Compiled Shared Edge Configuration Version 1",
  "description": "Deterministic output for a complete valid Registration Set. This is not deployed configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "compiler_version",
    "generation",
    "generation_digest",
    "previous_generation_digest",
    "reserved_paths",
    "identity_delivery",
    "application_states",
    "catalogue",
    "routes",
    "admission_policies"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "compiler_version": {
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "generation_digest": {
      "$ref": "#/$defs/digest"
    },
    "previous_generation_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "reserved_paths": {
      "const": [
        "/",
        "/.well-known",
        "/_platform"
      ]
    },
    "identity_delivery": {
      "$ref": "#/$defs/identityDelivery"
    },
    "application_states": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "description": "Entries are sorted by application_id.",
      "items": {
        "$ref": "#/$defs/applicationState"
      }
    },
    "catalogue": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "description": "Active listed entries are sorted by application_id.",
      "items": {
        "$ref": "#/$defs/catalogueEntry"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "description": "Active routes are sorted by route_prefix.",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "admission_policies": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "description": "Active admission policies are sorted by application_id.",
      "items": {
        "$ref": "#/$defs/admissionBinding"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identityDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_name",
        "context_contract_version"
      ],
      "properties": {
        "header_name": {
          "const": "X-Comfforts-Verified-Identity"
        },
        "context_contract_version": {
          "const": 1
        }
      }
    },
    "applicationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "registration_revision",
        "route_prefix",
        "lifecycle"
      ],
      "properties": {
        "application_id": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/applicationId"
        },
        "registration_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "route_prefix": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/routePrefix"
        },
        "lifecycle": {
          "enum": [
            "staged",
            "active",
            "suspended",
            "retired"
          ]
        }
      }
    },
    "catalogueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "title",
        "summary",
        "route_prefix",
        "admission_mode"
      ],
      "properties": {
        "application_id": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/applicationId"
        },
        "title": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/plainTitle"
        },
        "summary": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/plainSummary"
        },
        "route_prefix": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/routePrefix"
        },
        "admission_mode": {
          "enum": [
            "public",
            "authenticated",
            "restricted"
          ]
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "route_prefix",
        "attachments"
      ],
      "properties": {
        "application_id": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/applicationId"
        },
        "route_prefix": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/routePrefix"
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "description": "Attachments are sorted by descending mount specificity and then attachment_id.",
          "items": {
            "$ref": "urn:comfforts:app-platform:schema:application-attachment:v1"
          }
        }
      }
    },
    "admissionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "policy"
      ],
      "properties": {
        "application_id": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/applicationId"
        },
        "policy": {
          "$ref": "urn:comfforts:app-platform:schema:registration-set:v1#/$defs/admission"
        }
      }
    }
  }
}
