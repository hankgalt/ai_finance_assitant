# Local-only M0 defaults. Copy values into your shell environment if changes are needed.
# No provider or model credentials are used in M0.
AIFA_MODE=local
AIFA_HOST=127.0.0.1
AIFA_PORT=8000
AIFA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AIFA_LOG_LEVEL=INFO

# Reserved for M1. Setting a URL does not make the M0 backend Qdrant-ready.
# AIFA_QDRANT_URL=http://127.0.0.1:6333
AIFA_FINANCE_COLLECTION_ALIAS=finance_education_active
AIFA_TAX_COLLECTION_ALIAS=tax_education_active
AIFA_EXPECTED_PAYLOAD_SCHEMA_VERSION=1
# AIFA_EXPECTED_DENSE_MODEL_ID=
# AIFA_EXPECTED_SPARSE_MODEL_ID=

# Optional frontend override; the Vite development proxy works without it.
# VITE_API_BASE_URL=http://127.0.0.1:8000
