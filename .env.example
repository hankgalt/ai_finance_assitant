# =============================================================================
# AI Finance Assistant: backend configuration
# =============================================================================
# Copy to backend/.env:   cp .env.example backend/.env
# Every variable is optional unless marked REQUIRED; the value shown is the default.
# Comments list the allowed values. Never commit backend/.env: it holds your keys.
#
# Two ways to run the demo:
#
#   1. Credential-free (this file as-is). Works offline with no accounts. Market
#      data and news are synthetic and labelled; answers come from a deterministic
#      stand-in model, so conversation is scripted rather than natural.
#
#   2. Full live demo (recommended for grading). These are the values the owner's
#      demo configuration uses; everything not listed keeps the default in this file.
#
#        # Real model
#        AIFA_MODEL_MODE=openai_live
#        AIFA_OPENAI_API_KEY=<your key>
#        AIFA_OPENAI_TERMS_APPROVED=true
#        # Live market data: pick ONE provider
#        AIFA_PROVIDER_MODE=live
#        AIFA_MARKET_DATA_PROVIDER=massive        # or alpha_vantage (see Market data)
#        AIFA_MASSIVE_API_KEY=<your key>          # or AIFA_ALPHA_VANTAGE_API_KEY
#        AIFA_MASSIVE_TERMS_APPROVED=true         # or AIFA_ALPHA_VANTAGE_TERMS_APPROVED
#        AIFA_MASSIVE_ENTITLEMENT="owner-only Stocks Basic; EOD; 5 requests/minute; 2-year history"
#        # Live news
#        AIFA_TAVILY_API_KEY=<your key>
#        AIFA_TAVILY_TERMS_APPROVED=true
#        AIFA_TAVILY_ENTITLEMENT="private owner demo; public finance-news queries only"
#        # Keep market history across restarts (owner-only; see the cache section)
#        AIFA_PROVIDER_CACHE_OWNER_RISK_ACCEPTED=true
#        # Serve calibrated near-duplicate answers from the response cache
#        AIFA_RESPONSE_CACHE_SEMANTIC_MODE=serving
#        # Optional: LangSmith traces (inputs and outputs stay hidden)
#        AIFA_LANGSMITH_TRACING_ENABLED=true
#        AIFA_LANGSMITH_API_KEY=<your key>
#
#      Also start Qdrant and Redis (make qdrant-up, make response-cache-up) and build
#      both knowledge collections once (make knowledge-finance, make knowledge-tax).
#      Check GET /api/health/ready afterwards: it names any provider or model that
#      is not ready.
#
# Setting a *_TERMS_APPROVED flag to true records that you have reviewed that
# provider's terms for your use. Without it, live mode reports "not ready" and
# never falls back to synthetic data.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Runtime label shown in health output. local | test | production
# ("test" also swaps in a deterministic embedding encoder for the response cache).
AIFA_MODE=local
# loopback_development | iap. Production requires iap and never falls back.
AIFA_IDENTITY_MODE=loopback_development
# IAP mode requires the exact backend-service audience and owner admission email.
# The backend-service identifier is created in a later infrastructure slice.
# AIFA_IAP_AUDIENCE=/projects/730340912967/global/backendServices/<backend-service-id>
# AIFA_IAP_OWNER_EMAIL=vtalwar.w@comfforts.com
# JSON list of explicitly approved viewers; keep empty until access is granted.
AIFA_IAP_VIEWER_EMAILS=[]
# External browser path used by React, REST, and SSE in every mode.
AIFA_BASE_PATH=/finance_assistant
# Bind address. loopback_development rejects non-loopback hosts; a production
# non-loopback process must use verified IAP identity.
AIFA_HOST=127.0.0.1
# Backend port (1-65535). The Vite dev proxy expects 8000.
AIFA_PORT=8000
# Browser origins allowed to call the API directly (JSON list). Only needed if you set
# VITE_API_BASE_URL; the default Vite proxy is same-origin. The dev server runs on 5174.
AIFA_CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost:5173","http://127.0.0.1:5173"]
# DEBUG | INFO | WARNING | ERROR
AIFA_LOG_LEVEL=INFO
# REQUIRED. Workflow identity recorded on every Run and trace. Any id matching
# [A-Za-z0-9._:-], up to 128 characters.
AIFA_WORKFLOW_ID=finance-assistant
# Maximum graph steps per Run (4-64). The default leaves room for six agents plus routing.
AIFA_WORKFLOW_MAXIMUM_GRAPH_HOPS=16
# Seconds a chat Run may take before it ends as timed out (5-300).
AIFA_API_RUN_DEADLINE_SECONDS=60
# Maximum stored events replayed to a reconnecting stream (1-10000).
AIFA_API_SSE_REPLAY_LIMIT=1000

# -----------------------------------------------------------------------------
# Application storage and retention
# -----------------------------------------------------------------------------
# sqlite for loopback development; postgres for the managed deployment.
AIFA_STORAGE_BACKEND=sqlite
# SQLite database file, relative to backend/.
AIFA_STORAGE_PATH=data/ai_finance_assistant.sqlite3
# Managed PostgreSQL DSN. In deployment this comes from Secret Manager; never commit it.
# AIFA_POSTGRES_DSN=
# Bounded application/checkpoint pools. Two separate pools at this limit use at most four
# connections per container and must be measured before increasing.
AIFA_POSTGRES_POOL_MIN_SIZE=1
AIFA_POSTGRES_POOL_MAX_SIZE=2
AIFA_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# auto applies schemas for local/test qualification. Production must use verify_only and run
# `make managed-state-migrate` as an explicit operator job before starting the workload.
AIFA_STORAGE_MIGRATION_MODE=auto
# startup preserves the local lifecycle. Production uses scheduled and invokes
# `make managed-state-retention` independently from the web process.
AIFA_RETENTION_EXECUTION_MODE=startup
# Schema version the code expects. Do not change.
AIFA_STORAGE_EXPECTED_SCHEMA_VERSION=4
# Who can see this deployment: owner_only | shared_demo | public.
# Use owner_only for a local demo. It also decides whether the owner-only provider
# cache exception below can apply.
AIFA_LOCAL_DEPLOYMENT_AUDIENCE=owner_only
# Days before data is purged (1-3650).
AIFA_SESSION_RETENTION_DAYS=30
AIFA_PORTFOLIO_RETENTION_DAYS=365
AIFA_RUN_EVENT_RETENTION_DAYS=30
# Optional secret that enables the admin cache-purge endpoints. Leave unset to keep them off.
# AIFA_LOCAL_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Knowledge base (Qdrant)
# -----------------------------------------------------------------------------
# Qdrant URL. Start it with `make qdrant-up`. Unset or unreachable: readiness fails
# and Finance/Tax answers have no evidence.
AIFA_QDRANT_URL=http://127.0.0.1:6333
# Managed Qdrant runtime API key. It comes from Secret Manager and is never committed.
# AIFA_QDRANT_API_KEY=
# Aliases that point at the activated collections. Created by `make knowledge-finance`
# and `make knowledge-tax`.
AIFA_FINANCE_COLLECTION_ALIAS=finance_education_active
AIFA_TAX_COLLECTION_ALIAS=tax_education_active
# Compatibility checks against the built collections. Do not change: they must match
# the pinned embedding models, or readiness fails instead of serving mismatched vectors.
AIFA_EXPECTED_PAYLOAD_SCHEMA_VERSION=1
AIFA_EXPECTED_DENSE_MODEL_ID=BAAI/bge-small-en-v1.5
AIFA_EXPECTED_DENSE_MODEL_REVISION=aa8f8b060edb00e03bfdd08813a2949946c8ba55
AIFA_EXPECTED_DENSE_ARTIFACT_SHA256=51f1bd0addd6e859e42c2c8021a5e5461385bb676a649f4b269aa445449f2431
AIFA_EXPECTED_DENSE_DIMENSIONS=384
AIFA_EXPECTED_SPARSE_MODEL_ID=Qdrant/bm25
AIFA_EXPECTED_SPARSE_MODEL_REVISION=22b8d2af71a76161e18dd432d2cee0eefa66e412
AIFA_EXPECTED_SPARSE_ARTIFACT_SHA256=019f104ba2ed07436d05f9cdd3383034ad66014edc27fc651f837e1a038b6451
AIFA_EXPECTED_CHUNKING_POLICY_VERSION=structural-v1

# -----------------------------------------------------------------------------
# Language model
# -----------------------------------------------------------------------------
# credential_free = deterministic stand-in (offline, scripted answers)
# openai_live     = OpenAI. Live demo: openai_live.
AIFA_MODEL_MODE=credential_free
# OpenAI model id used for routing, agents and synthesis.
AIFA_OPENAI_MODEL=gpt-6.1-sol
# Your OpenAI key. OPENAI_API_KEY is also accepted.
# AIFA_OPENAI_API_KEY=
# true | false. Must be true for openai_live; otherwise the model reports not ready.
# AIFA_OPENAI_TERMS_APPROVED=false
# Model calls per Run (1-24): one routing call, up to six agents, one synthesis.
AIFA_MODEL_REQUEST_BUDGET=8
# Attempts per model call (1-3), timeout per call in seconds (up to 120), and the
# maximum characters sent per call (1000-200000).
AIFA_MODEL_MAXIMUM_ATTEMPTS=3
AIFA_MODEL_TIMEOUT_SECONDS=30
AIFA_MODEL_MAXIMUM_INPUT_CHARACTERS=40000

# -----------------------------------------------------------------------------
# Market data and news
# -----------------------------------------------------------------------------
# credential_free = synthetic, labelled quotes, history and news (offline)
# live            = the market provider below plus Tavily news. Live demo: live.
AIFA_PROVIDER_MODE=credential_free
# Live market provider: alpha_vantage | massive.
#   alpha_vantage: end-of-day quotes and recent daily history. The free tier allows 5
#                  requests per minute and about 25 per day.
#   massive:       previous-day quotes and daily history (Stocks Basic: end-of-day,
#                  5 requests per minute, 2 years of history). Individual plans allow only
#                  the account owner to view the data; showing it to an instructor or other
#                  viewers needs Business rights (docs/M3_provider_policy.md).
# Live demo: massive when only you watch the screen; alpha_vantage when others will.
AIFA_MARKET_DATA_PROVIDER=alpha_vantage
# Provider keys. Only the selected market provider's key is needed, plus Tavily for news.
# AIFA_ALPHA_VANTAGE_API_KEY=
# AIFA_MASSIVE_API_KEY=
# AIFA_TAVILY_API_KEY=
# true | false. The selected market provider and Tavily must be true in live mode.
# AIFA_ALPHA_VANTAGE_TERMS_APPROVED=false
# AIFA_MASSIVE_TERMS_APPROVED=false
# AIFA_TAVILY_TERMS_APPROVED=false
# Free-text note describing what your plan allows (1-512 characters). It has no effect on
# behavior; it is copied into the `provenance.entitlement` field of live quote, history,
# and news results returned by the REST API (/market/quotes, /market/history) and the
# MCP get_market_quote tool, and stored with each cached daily bar. The web app and chat
# answers do not display it. Write your plan, data delay, rate limit, and who may see the data.
# If unset, these defaults are used:
#   alpha_vantage: "conditional-private-demo; verify account terms before live use"
#   massive:       "conditional-owner-only-demo; verify business/display rights before sharing data"
#   tavily:        "conditional-private-demo; third-party source rights remain separate"
# Example values:
# AIFA_ALPHA_VANTAGE_ENTITLEMENT="private owner demo; EOD quote and daily history"
# AIFA_MASSIVE_ENTITLEMENT="owner-only Stocks Basic; EOD; 5 requests/minute; 2-year history"
# AIFA_TAVILY_ENTITLEMENT="private owner demo; public finance-news queries only"
# Maximum live provider requests per operation (0-100). Each chat Run, Market page
# request, and MCP tool call gets its own budget. A portfolio question uses one quote
# request per ticker holding (holdings beyond the budget keep their imported price); a
# Market search uses one quote and one history request. On the Market page, repeating a
# quote within five minutes spends no quota, and cached daily history is reused everywhere.
# These are per-operation caps, not a daily limit: the free Alpha Vantage tier allows
# about 25 requests a day in total. 5 is a safe default.
AIFA_MARKET_PROVIDER_REQUEST_BUDGET=5
AIFA_NEWS_PROVIDER_REQUEST_BUDGET=3
# Provider rate limit (1-600 requests per rolling 60 seconds), shared by every chat Run,
# Market page request, and MCP call in the backend process. Requests beyond it fail fast
# with "Try again in N seconds"; each slot frees up 60 seconds after its request. Set it to
# your plan's per-minute limit: 5 for the free Alpha Vantage tier.
AIFA_MARKET_PROVIDER_REQUESTS_PER_MINUTE=5
AIFA_NEWS_PROVIDER_REQUESTS_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Market-history cache (application database plus an in-memory front)
# -----------------------------------------------------------------------------
# true | false. Reuses daily history so repeated requests spend no provider quota.
AIFA_PROVIDER_CACHE_ENABLED=true
# Stored history survives restarts only when one of these holds:
#   AIFA_PROVIDER_CACHE_RETENTION_PERMISSION=verified  (your plan permits storing data), or
#   AIFA_LOCAL_DEPLOYMENT_AUDIENCE=owner_only and AIFA_PROVIDER_CACHE_OWNER_RISK_ACCEPTED=true
#     (you accept, for your own use, that storage rights are unconfirmed).
# Otherwise only the short-lived in-memory cache is used. This is your call about your
# provider's terms; neither option grants contractual permission.
# verified | unverified
AIFA_PROVIDER_CACHE_RETENTION_PERMISSION=unverified
# true | false
AIFA_PROVIDER_CACHE_OWNER_RISK_ACCEPTED=false
# Days to keep stored bars (1-3650).
AIFA_PROVIDER_CACHE_RETENTION_DAYS=3650
# The most recent N days (0-31) are re-checked every refresh interval
# (60-604800 seconds) to pick up late corrections.
AIFA_PROVIDER_CACHE_RECENT_TAIL_DAYS=7
AIFA_PROVIDER_CACHE_TAIL_REFRESH_SECONDS=21600
# In-memory front cache: seconds per entry (0-86400) and maximum entries (1-10000).
AIFA_PROVIDER_CACHE_MEMORY_TTL_SECONDS=300
AIFA_PROVIDER_CACHE_MEMORY_MAX_ENTRIES=128
# Cache format versions. Do not change.
AIFA_PROVIDER_CACHE_SCHEMA_VERSION=1
AIFA_PROVIDER_CACHE_POLICY_VERSION=historical-daily-v1

# -----------------------------------------------------------------------------
# Model response cache (optional; Redis)
# -----------------------------------------------------------------------------
# Reuses answers for repeated standalone Finance Q&A and Tax Education questions within
# the same session, after re-checking the current evidence.
# disabled | in_memory | redis. With redis, start it first with `make response-cache-up`;
# if Redis is unreachable the cache reports unavailable and requests run normally.
AIFA_RESPONSE_CACHE_ADAPTER=redis
# disabled | shadow | serving.
#   shadow:  semantic near-matches are measured but never served; exact matches can be.
#   serving: near-matches at or above the similarity below are also served. Qualified and
#            owner-approved for the private demo at 0.92 on 2026-10-31
#            (docs/evidence/M6_1_semantic_calibration.md). Live demo: serving.
AIFA_RESPONSE_CACHE_SEMANTIC_MODE=shadow
AIFA_RESPONSE_CACHE_REDIS_URL=redis://127.0.0.1:6379/0
AIFA_RESPONSE_CACHE_INDEX_NAME=aifa_model_response_cache_v1
# Entry lifetime in seconds (1-86400) and lookup timeout in milliseconds (10-2000).
AIFA_RESPONSE_CACHE_TTL_SECONDS=86400
AIFA_RESPONSE_CACHE_LOOKUP_TIMEOUT_MILLISECONDS=100
# Minimum similarity for a near-match (0.0-1.0). 0.92 is the calibrated value.
AIFA_RESPONSE_CACHE_MINIMUM_SIMILARITY=0.92
# Entry limit for the in_memory adapter only (1-100000).
AIFA_RESPONSE_CACHE_MEMORY_MAX_ENTRIES=1000
# Cache format versions. Do not change.
AIFA_RESPONSE_CACHE_SCHEMA_VERSION=1
AIFA_RESPONSE_CACHE_POLICY_VERSION=public-rag-evidence-bound-v2

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# disabled | in_memory | opentelemetry. Feeds operational traces and metrics; the
# Inspector uses run events and works in every mode.
AIFA_OBSERVABILITY_MODE=opentelemetry
# REQUIRED. Service name on traces and metrics ([A-Za-z0-9._:-], up to 128 chars).
AIFA_OTEL_SERVICE_NAME=ai-finance-assistant
# true | false. Sends traces and metrics to the endpoint below. Start a local collector
# with `make observability-up` first.
AIFA_OTEL_EXPORT_ENABLED=false
AIFA_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Metric export interval in milliseconds (1000-600000).
AIFA_OTEL_METRIC_EXPORT_INTERVAL_MILLIS=60000
# Optional LangSmith agent tracing. Inputs and outputs are always hidden.
# true | false (LANGSMITH_TRACING and LANGCHAIN_TRACING_V2 are also accepted).
AIFA_LANGSMITH_TRACING_ENABLED=false
# Needed only when tracing is enabled (LANGSMITH_API_KEY is also accepted).
# AIFA_LANGSMITH_API_KEY=
# REQUIRED. LangSmith project name, even when tracing is off (LANGSMITH_PROJECT is also
# accepted).
AIFA_LANGSMITH_PROJECT=ai-finance-assistant-local

# -----------------------------------------------------------------------------
# Test-only switches (set by Make targets; leave unset)
# -----------------------------------------------------------------------------
# AIFA_RUN_LIVE_PROVIDER_TESTS=false   # set by `make provider-live-check`
# AIFA_RUN_LIVE_MODEL_TESTS=false      # set by `make model-live-check`

# -----------------------------------------------------------------------------
# Frontend (read by Vite from frontend/.env, not by the backend)
# -----------------------------------------------------------------------------
# Optional. Leave unset to use the dev proxy (/api -> http://127.0.0.1:8000). If set,
# the browser calls the backend directly and AIFA_CORS_ORIGINS must include the app origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000
