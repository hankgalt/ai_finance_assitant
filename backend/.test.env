# Safe defaults for ordinary automated tests. Never add credentials to this file.
AIFA_MODE=test
AIFA_PROVIDER_MODE=credential_free
AIFA_MODEL_MODE=credential_free
AIFA_WORKFLOW_ID=finance-assistant-test
AIFA_OBSERVABILITY_MODE=in_memory
AIFA_OTEL_SERVICE_NAME=ai-finance-assistant-test
AIFA_OTEL_EXPORT_ENABLED=false
AIFA_LANGSMITH_TRACING_ENABLED=false
AIFA_LANGSMITH_PROJECT=ai-finance-assistant-test
AIFA_RESPONSE_CACHE_ADAPTER=disabled
AIFA_STORAGE_EXPECTED_SCHEMA_VERSION=3
