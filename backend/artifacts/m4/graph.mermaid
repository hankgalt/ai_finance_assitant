---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	finance_qa(finance_qa)
	portfolio_analysis(portfolio_analysis)
	market_analysis(market_analysis)
	goal_planning(goal_planning)
	news_synthesizer(news_synthesizer)
	tax_education(tax_education)
	synthesize(synthesize)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	finance_qa --> synthesize;
	goal_planning --> synthesize;
	market_analysis --> synthesize;
	news_synthesizer --> synthesize;
	portfolio_analysis --> synthesize;
	router -.-> finance_qa;
	router -.-> goal_planning;
	router -.-> market_analysis;
	router -.-> news_synthesizer;
	router -.-> portfolio_analysis;
	router -.-> synthesize;
	router -.-> tax_education;
	tax_education --> synthesize;
	synthesize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
